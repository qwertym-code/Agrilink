# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit real credentials.

PORT=5000

# MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers. Replace <password> with your database user's password,
# and put the database name (agrilink) before the `?`:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/agrilink?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Origin allowed to call this API (the React dev server).
CLIENT_URL=http://localhost:5173

# Optional. Only needed if startup fails with "querySrv ECONNREFUSED".
# That means Node's DNS resolver can't look up the Atlas SRV record — usually a
# local DNS proxy (ad-blocker, Pi-hole, VPN) that is configured but not running.
# DNS_SERVERS=8.8.8.8,1.1.1.1
